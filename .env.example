# Lupe CTI — Environment Variables Template
# Copy this file to `.env` and fill in your API keys.
# Never commit `.env` to git. Use `lupe config set` for interactive setup.
#
# Signup URLs: https://github.com/centinela/lupe#threat-intelligence-providers

# =============================================================================
# LLM Provider (set LUPE_LLM_PROVIDER to one of: ollama, openai, anthropic, openrouter)
# =============================================================================

# Ollama (local or cloud)
# Local: leave LUPE_OLLAMA_BASE_URL as default and do not set LUPE_OLLAMA_API_KEY
# Cloud: https://ollama.com — generate API key at https://ollama.com/settings/keys
LUPE_OLLAMA_BASE_URL=http://localhost:11434
LUPE_OLLAMA_MODEL=gemma3:4b
LUPE_OLLAMA_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
LUPE_OPENAI_API_KEY=
LUPE_OPENAI_MODEL=gpt-4o-mini
LUPE_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic — https://console.anthropic.com/settings/keys
LUPE_ANTHROPIC_API_KEY=
LUPE_ANTHROPIC_MODEL=claude-3-5-haiku-latest
LUPE_ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenRouter — https://openrouter.ai/keys
LUPE_OPENROUTER_API_KEY=
LUPE_OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
LUPE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =============================================================================
# Threat Intelligence Providers (all free tier — sign up at each)
# =============================================================================

LUPE_VIRUSTOTAL_KEY=         # https://www.virustotal.com/
LUPE_ABUSEIPDB_KEY=          # https://www.abuseipdb.com/api
LUPE_SHODAN_KEY=             # https://shodan.io/
LUPE_OTX_KEY=                # https://otx.alienvault.com/
LUPE_URLSCAN_KEY=            # https://urlscan.io/
LUPE_HIBP_KEY=               # https://haveibeenpwned.com/API/Key
LUPE_GREYNOISE_KEY=          # https://viz.greynoise.io/
LUPE_IPQS_KEY=               # https://www.ipqualityscore.com/
LUPE_NUMVERIFY_KEY=          # https://numverify.com/
LUPE_EMAILREP_KEY=           # https://emailrep.io/
LUPE_GOOGLESB_KEY=           # https://developers.google.com/safe-browsing/v4/get-started
LUPE_PHISHTANK_KEY=          # https://www.phishtank.com/api_register.php
LUPE_PULSEDIVE_KEY=          # https://pulsedive.com/
LUPE_HYBRID_ANALYSIS_KEY=    # https://www.hybrid-analysis.com/
LUPE_CENSYS_ID=              # https://search.censys.io/
LUPE_CENSYS_SECRET=          # Censys secret (paired with LUPE_CENSYS_ID)
LUPE_SPAMHAUS_KEY=           # https://www.spamhaus.com/

# =============================================================================
# MISP Integration
# =============================================================================

LUPE_MISP_URL=               # e.g. https://misp.example.org
LUPE_MISP_KEY=               # MISP automation key (UUID)

# =============================================================================
# Storage
# =============================================================================

LUPE_DB_PATH=                # default: XDG data dir (auto-detected)
LUPE_GITHUB_REPO=lupe-cti/lupe  # DO NOT change unless you know what you're doing (supply chain risk)

# =============================================================================
# Optional flags
# =============================================================================

LUPE_HTTP_TIMEOUT=15.0       # Default HTTP request timeout in seconds
LUPE_LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR
